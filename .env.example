# Alto runtime basics
ALTO_ENTRYPOINTS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
ALTO_RPC_URL=http://127.0.0.1:8545
ALTO_NETWORK_NAME=uptick-local
ALTO_PORT=3000
ALTO_LOG_LEVEL=info

# Executor settings
ALTO_EXECUTOR_PRIVATE_KEYS=replace-with-executor-private-keys-comma-separated
ALTO_UTILITY_PRIVATE_KEY=replace-with-utility-private-key
ALTO_MIN_EXECUTOR_BALANCE=50000000000000000
ALTO_BUNDLER_INITIAL_COMMISSION=15
ALTO_TRANSACTION_UNDERPRICED_MULTIPLIER=170
ALTO_SEND_HANDLE_OPS_RETRY_COUNT=4
ALTO_EXECUTOR_REFILL_INTERVAL=120

# Authentication and protection
ALTO_AUTH_MODE=api-key
ALTO_AUTH_API_KEYS=replace-with-key-a,replace-with-key-b
ALTO_AUTH_PROTECTED_METHODS=eth_sendUserOperation,pimlico_sendUserOperationNow,boost_sendUserOperation
ALTO_AUTH_RATE_LIMIT_WINDOW_MS=1000
ALTO_AUTH_RATE_LIMIT_MAX_REQUESTS=10
ALTO_AUTH_GAS_QUOTA_DAILY_LIMIT=50000000

# Dynamic policy storage
ALTO_REDIS_MEMPOOL_URL=redis://127.0.0.1:6379
ALTO_AUTH_API_KEY_POLICIES_REDIS_KEY=auth:api-key-policies
ALTO_AUTH_API_KEY_POLICIES_CACHE_MS=3000
